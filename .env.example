# Provider routing -----------------------------------------------------------
# Providers are attempted from left to right. Valid values: gemini, groq, ollama.
# Use "ollama" by itself when selected text must remain local.
PROMPT_REWRITER_PROVIDER_ORDER=gemini,ollama

# Global keyboard/clipboard behavior ----------------------------------------
PROMPT_REWRITER_HOTKEY=ctrl+shift+space
PROMPT_REWRITER_COPY_CHORD=ctrl+c
PROMPT_REWRITER_PASTE_CHORD=ctrl+v
PROMPT_REWRITER_MAX_INPUT_CHARS=12000
PROMPT_REWRITER_MAX_OUTPUT_CHARS=16000
PROMPT_REWRITER_COPY_TIMEOUT_SECONDS=0.35
PROMPT_REWRITER_PASTE_SETTLE_SECONDS=0.25
# After a successful paste, restore the prior text. Failure paths always attempt restoration.
# Plain-text restoration is best effort; rich clipboard formats are not saved.
PROMPT_REWRITER_RESTORE_CLIPBOARD=true
PROMPT_REWRITER_LOG_LEVEL=INFO

# Gemini cloud provider ------------------------------------------------------
# Optional. Leave blank to skip Gemini. Never paste a real key into a committed file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=6.0
GEMINI_MAX_TOKENS=650

# Groq cloud provider --------------------------------------------------------
# Optional. Leave blank to skip Groq and continue to the next provider.
GROQ_API_KEY=
# llama-3.1-8b-instant is retired for free/developer accounts as of 2026-08-16.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=4.0
GROQ_MAX_TOKENS=650

# Ollama local provider ------------------------------------------------------
# Loopback base URL only; the app rejects remote hosts and adds API paths.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Local model loading can make the first request slower than later requests.
OLLAMA_TIMEOUT_SECONDS=45.0
OLLAMA_MAX_TOKENS=650
OLLAMA_KEEP_ALIVE=10m
